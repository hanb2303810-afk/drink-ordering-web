<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.group04</groupId>
    <artifactId>drink-ordering-web-server</artifactId>
    <version>1.0.0</version>
    <name>drink-ordering-web-server</name>

    <properties>
        <!-- Mã biên dịch ở mức Java 17 theo ràng buộc học phần CT240.
             pom gốc của nhóm pin JaCoCo 0.8.11 (máy nhóm dùng JDK 21); máy phát triển này
             chỉ có JDK 25 nên dùng 0.8.14 (bản đầu hỗ trợ Java 25) - NGƯỠNG KHÔNG ĐỔI:
             Line >= 80%, Branch >= 75%. Trên máy JDK 21 có thể hạ về 0.8.11 vẫn đạt. -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <mockito.version>5.11.0</mockito.version>
        <jacoco.version>0.8.14</jacoco.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Giữ nguyên cấu hình JaCoCo của nhóm: báo cáo ở giai đoạn test,
                 check ngưỡng Line >= 80%, Branch >= 75% ở giai đoạn verify. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <!-- Main / SeatReservationDemo là chương trình demo console của nhóm,
                                     Spring main class chỉ cấu hình -không đưa vào đo bao phủ. -->
                                <exclude>com/group04/Main.class</exclude>
                                <exclude>com/group04/SeatReservationDemo.class</exclude>
                                <exclude>com/group04/DrinkOrderingApplication.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>com/group04/Main.class</exclude>
                                <exclude>com/group04/SeatReservationDemo.class</exclude>
                                <exclude>com/group04/DrinkOrderingApplication.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
